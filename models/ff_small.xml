<mujoco model="ff_small">
  <!-- CubeSat-class servicer: high arm/base mass ratio (6.6 kg arm / 20 kg base).
       Only the base differs between servicers; the arm is in common/. -->
  <include file="common/arm_defs.xml"/>

  <worldbody>
    <body name="base" pos="0 0 0">
      <freejoint name="base_free"/>
      <geom name="base_geom" type="box" size="0.2 0.2 0.1" mass="20"/>
      <!-- Antenna boresight = site z-axis; the +/-5 deg pointing limit is measured on it. -->
      <site name="antenna" pos="0 0 0.1" zaxis="0 0 1" type="cylinder" size="0.03 0.05" rgba="0.9 0.7 0.1 1"/>

      <!-- Shoulder mounted on the +x face of the base -->
      <body name="mount" pos="0.2 0 0">
        <include file="common/arm_body.xml"/>
      </body>
    </body>
  </worldbody>
</mujoco>
